<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://ru.kvas.chronos.view.location/locationDetailView.title"
      focusComponent="form">
    <data>
        <instance id="locationDc"
                  class="ru.kvas.chronos.entity.Location">
            <fetchPlan extends="_base"/>
            <loader id="locationDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="locationDc">
            <select id="typeField" property="type"/>
            <textField id="nameField" property="name"/>
            <textArea id="addressField" property="address" height="9.5em"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>